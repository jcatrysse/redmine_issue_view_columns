<%= stylesheet_link_tag 'issue_view_columns', plugin: "redmine_issue_view_columns", media: 'all'%>
<%= javascript_include_tag(:'relation_type_matrix', plugin: "redmine_issue_view_columns") %>

<%= form_tag(update_issue_view_columns_relation_types_path, method: :post) do %>
  <%= hidden_field_tag 'project_id', @project.id %>
  <fieldset class="box">
    <legend><%= l(:label_issue_view_columns_relation_types_tab) %></legend>
    <div class="field">
      <% selected_relation_types = project_relation_types_override(@project) %>
      <% all_relations = project_relation_types_all?(@project) %>
      <% if additional_relation_type_keys.any? %>
        <table class="list permissions ivc-relation-types-matrix">
          <thead>
            <tr>
              <th><%= l(:label_project) %></th>
              <th class="ivc-check-all"><%= l(:label_issue_view_columns_all_relations) %></th>
              <% additional_relation_type_keys.each do |relation_type| %>
                <% relation_label = IssueRelation::TYPES.dig(relation_type, :name) %>
                <th><%= relation_label ? l(relation_label) : relation_type %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><%= @project.name %></td>
              <td class="ivc-check-all">
                <%= hidden_field_tag "project_relation_types_all[#{@project.id}]", '0' %>
                <%= check_box_tag "project_relation_types_all[#{@project.id}]",
                                  '1',
                                  all_relations,
                                  class: 'ivc-check-all-toggle',
                                  data: {
                                    target: "ivc-project-#{@project.id}",
                                    previous: selected_relation_types.join(",")
                                  } %>
              </td>
              <%= hidden_field_tag "project_relation_types[#{@project.id}][]", '' %>
              <% additional_relation_type_keys.each do |relation_type| %>
                <td class="ivc-project-<%= @project.id %>">
                  <%= check_box_tag "project_relation_types[#{@project.id}][]",
                                    relation_type,
                                    selected_relation_types.include?(relation_type.to_s) || all_relations,
                                    class: 'ivc-relation-checkbox' %>
                </td>
              <% end %>
            </tr>
          </tbody>
        </table>
      <% else %>
        <em class="info"><%= l(:label_issue_view_columns_no_additional_relation_types) %></em>
      <% end %>
    </div>
    <em class="info"><%= l(:label_issue_view_columns_relation_types_hint) %></em>
    <em class="info"><%= l(:label_issue_view_columns_all_relations_hint) %></em>
  </fieldset>

  <%= submit_tag t(:button_save) -%>
  <%= submit_tag t(:button_cancel) -%>
<% end %>

<style>
.ivc-relation-types-matrix th,
.ivc-relation-types-matrix td {
    text-align: center;
    padding: 4px 6px;
}

.ivc-relation-types-matrix {
    width: auto;
    table-layout: auto;
    border-collapse: collapse;
    display: inline-table;
}

.ivc-relation-types-matrix.list {
    width: auto;
}

.ivc-relation-types-matrix th {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
    height: 140px;
}

.ivc-relation-types-matrix td:first-child,
.ivc-relation-types-matrix th:first-child {
    text-align: left;
}

.ivc-relation-types-matrix th.ivc-check-all,
.ivc-relation-types-matrix td.ivc-check-all {
    width: 60px;
}
</style>
