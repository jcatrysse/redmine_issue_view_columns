<% if relates_clique_available?(issues) %>
  <li>
    <%= context_menu_link(
          l(:label_relates_to),
          issue_view_columns_relations_path(ids: issues.map(&:id), back_url: back),
          method: :post,
          class: 'icon icon-link'
        ) %>
  </li>
<% end %>

<% if (relation = relates_relation_for_context_menu(issues)) && relation.deletable? %>
  <li>
    <%= context_menu_link(
          l(:label_relation_delete),
          issue_view_columns_relation_path(relation, back_url: back),
          method: :delete,
          data: { confirm: l(:text_are_you_sure) },
          class: 'icon icon-link-break'
        ) %>
  </li>
<% end %>
